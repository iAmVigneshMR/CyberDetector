{
  "name": "cyberdetector",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-browser (Chrome + Firefox, Manifest V3) phishing and deepfake detection extension.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "node scripts/build.mjs --zip",
    "test": "node --test tests/*.test.js",
    "lint:firefox": "npx --yes web-ext lint -s dist/firefox",
    "start:firefox": "npx --yes web-ext run -s dist/firefox",
    "start:chrome": "npx --yes web-ext run -s dist/chrome -t chromium"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
